{
  "name": "obsidian-spectre",
  "version": "0.1.0",
  "description": "Spectre - embedded terminal view for Obsidian, rendered with ghostty-web",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite build --mode development",
    "build": "vite build --mode production",
    "test": "nub --test 'src/**/*.test.ts'",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "ghostty-web": "^0.4.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "obsidian": "^1.13.1",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.6.0",
      "onFail": "warn"
    }
  }
}
