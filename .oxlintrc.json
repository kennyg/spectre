{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "no-promise-executor-return": "error",
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "__indirect_function_table",
          "__term",
          "__ghostty"
        ]
      }
    ]
  },
  "ignorePatterns": [
    "dist",
    "main.js",
    "node_modules"
  ]
}
